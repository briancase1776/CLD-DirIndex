#!/bin/sh
# scripts/git-hooks/pre-commit.d/30-symbol-audit
# @brief Symbol-audit gate: run scripts/symbol-audit/check.sh over the
# paths the pre-commit dispatcher routes to it.
#
# Called by scripts/git-hooks/pre-commit from the root of a temp tree
# holding the STAGED content (GIT_DIR/GIT_WORK_TREE point git at it), as
#     30-symbol-audit [PATH...] [--gone PATH...]
# -- the staged paths that exist in the commit, then the ones it deletes
# or renames away. Both lists go to the checker unchanged.
#
# Blocks the commit when a staged symbol index (<file>.cld, line 1
# "FILE <path>") has an unknown header (SYM-HDR), names a target that
# does not exist (SYM-DEAD -- including a target this commit deletes or
# renames away while its <file>.cld stays), is not named after its
# target (SYM-NAME), shares its target with another index (SYM-DUP), or
# carries an unusable lookup key (SYM-KEY). Paths that are neither a .cld
# nor a watched source are ignored by the checker.
#
# A missing or non-executable checker BLOCKS: a gate that cannot run must
# never read as a gate that passed. So does being run by a dispatcher
# that does not export CLD_GATE_CONTRACT=2: an installed hook older than
# this toolkit, which may judge the working tree instead of the commit,
# hand over no deleted paths, or skip merges. The cure is to re-run
# scripts/git-hooks/install.sh.
#
# The checker reads only the toolkit, the directories of the paths it is
# handed, and the targets of the symbol indexes among them; and it takes
# its arguments from a file (--paths-from), so the dispatcher hands over
# a commit of any size in one call:
# cld-gate: partial-tree
# cld-gate: paths-from

case ${CLD_GATE_CONTRACT:-} in
  ''|*[!0-9]*|0|1)
    echo "symbol-audit gate: BLOCKED -- the installed git hook is older than" \
         "this toolkit (it does not pass CLD_GATE_CONTRACT=2), so it may not" \
         "judge what is being committed; re-run scripts/git-hooks/install.sh" >&2
    exit 2 ;;
esac

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "symbol-audit gate: BLOCKED -- not inside a git work tree" >&2
  exit 2
}
rel=scripts/symbol-audit/check.sh
checker=$root/$rel

if [ ! -f "$checker" ]; then
  echo "symbol-audit gate: BLOCKED -- the checker $rel is missing from the tree being committed" >&2
  exit 2
fi
if [ ! -x "$checker" ]; then
  echo "symbol-audit gate: BLOCKED -- the checker $rel is not executable" \
       "(chmod +x $rel, then git add it)" >&2
  exit 2
fi

[ "$#" -eq 0 ] && exit 0

exec "$checker" "$@"
