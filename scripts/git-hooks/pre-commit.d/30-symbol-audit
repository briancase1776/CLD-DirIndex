#!/bin/sh
# @brief Symbol-audit gate: run scripts/symbol-audit/check.sh on the
# staged files passed as positional args by the pre-commit dispatcher.
#
# Blocks the commit when a staged symbol index (<file>.cld, line 1
# "FILE <path>") has an unknown header (SYM-HDR), names a target that
# does not exist (SYM-DEAD), is not named after its target (SYM-NAME),
# shares its target with another index (SYM-DUP), or carries an
# unusable lookup key (SYM-KEY). Unwatched staged files are ignored by
# the checker.

repo=$(git rev-parse --show-toplevel)
checker="$repo/scripts/symbol-audit/check.sh"

[ -x "$checker" ] || exit 0
[ "$#" -eq 0 ] && exit 0

"$checker" "$@"
