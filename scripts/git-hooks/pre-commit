#!/bin/sh
# scripts/git-hooks/pre-commit
# @brief Pre-commit and pre-merge-commit dispatcher: run a chained foreign
# hook, then every check in scripts/git-hooks/pre-commit.d/ over the
# STAGED tree.
# (marker: cld-dispatcher -- install.sh recognises its own hook by it)
#
# Usage:
#   installed by install.sh as pre-commit AND pre-merge-commit (a merge
#   that needs no hand resolution runs pre-merge-commit, not pre-commit,
#   so a gate on pre-commit alone lets every clean merge through)
#   scripts/git-hooks/pre-commit --audit   the same checks over the same
#       staged diff, on demand: prints how the diff was routed, never
#       runs a chained hook
#
# Exit: 0 the commit may go ahead; 1 a check found something, or the
# chained hook failed; 2 a check could not run, or the gate itself could
# not be built (a broken setup, not a finding). --audit exits the same
# way, saying "would let this commit through" or "would BLOCK".
#
# What it does, in order:
#   1. Runs the chained hook, if install.sh found a foreign hook of this
#      name and set it aside as cld-chained/<name> in the hooks
#      directory. It runs FIRST because a hook such as a formatter may
#      re-stage files, and the .cld checks must judge what will actually
#      be committed. It is run under the path git would have run it by:
#      a shell script (a #! line naming sh, bash, dash, ksh, zsh and the
#      like, directly or through env, or a text file with no #! line,
#      which git runs with sh) is sourced by that shell with $0 set to
#      the original hook path -- hook managers such as husky dispatch on
#      basename "$0" and find their files through dirname "$0". Anything
#      else, a compiled hook included, is executed where it lies, which
#      keeps its own name. Its failure blocks, but the .cld
#      checks still run, so every failure shows in one pass. A chained
#      hook that is not an executable file is not run (git would not have
#      run it either), and is named.
#   2. Reads the staged diff with renames OFF, so a rename arrives as a
#      deletion plus an addition, and with -z and core.quotePath=false,
#      so no name arrives C-quoted. Deleted paths are GONE; every other
#      status (added, modified, type changed) is PRESENT. In a merge this
#      is the merge's change against the first parent.
#   3. Decides which checks run: the ones IN the commit (the gate that
#      judges a commit is the gate in that commit), and every check HEAD
#      has must still be among them -- a commit that deletes a check,
#      renames it to a name that is not a check, or removes pre-commit.d,
#      cannot switch it off. (Renumbering one, a rename git pairs from
#      one check name to another, keeps it.)
#   4. Materialises the index -- exactly what is being committed -- in a
#      temp tree with git checkout-index, and runs every check there with
#      GIT_DIR=<this repo's git dir> GIT_WORK_TREE=<temp tree>. So an
#      unstaged edit, an unstaged deletion or an untracked file cannot
#      change the answer, and neither can a partial commit (git commit
#      <paths>): git hands the hook that commit's own index in
#      GIT_INDEX_FILE, which is made absolute here because git reads a
#      relative one against the work tree, and the work tree moves.
#      When every check is marked "cld-gate: partial-tree" (both of the
#      toolkit's are), only what they read is built: the toolkit, and
#      each directory a staged or deleted path is in -- its .cld files
#      and staged files with their content, every other entry as an
#      empty placeholder of the right type -- plus the target of each
#      staged symbol index (or of one a deletion leaves behind). So the
#      cost follows the size of the change, not of the repo. The whole
#      tree is built instead for a check without the mark, and whenever a
#      check would follow a symlink out of the partial tree or an index
#      entry names a path below its own directory.
#   5. Routes the paths. A PRESENT path is passed if it exists in the
#      temp tree in any form ([ -e ] || [ -L ]: a dangling symlink and a
#      symlink to a directory are still entries). GONE paths are passed
#      after --gone, together with every ancestor directory that no
#      longer exists (deleting lib/sub/ must reach the "D sub/" entry in
#      lib/index.cld). A gone path that exists again in the staged tree
#      (a file replaced by a directory) is not gone, and is dropped.
#      Nothing else is added: the deletion itself never drags in a whole
#      index.
#
# The contract with each check in pre-commit.d/ (and, through it, with
# each checker): it runs from the temp tree's root with GIT_DIR,
# GIT_WORK_TREE and CLD_GATE_CONTRACT=2 exported, and is called as
#     NN-check [PATH...] [--gone PATH...]
# Every PATH is repo-root-relative and spelled the way git spells it,
# except that a root-level name starting with '-' is passed as ./-name.
# Everything after the first --gone is a gone path; gone directories
# carry no trailing slash. A check that exits non-zero blocks: 1 means
# "found something", anything else "could not check", which blocks too.
# A very large commit is split into several calls, each standing alone,
# so no argument list can overflow; the lines a check prints across them
# are shown once each. Two lines a check may carry change that:
#   # cld-gate: paths-from    call it ONCE, as NN-check --paths-from FILE,
#                             FILE holding the same arguments one per
#                             line -- one call, one verdict, any size
#   # cld-gate: partial-tree  it reads only what the toolkit's checks
#                             read (step 4); a check that reads anything
#                             else must not say so
# Both of the toolkit's checks carry both.
#
# What counts as a check: a file in pre-commit.d/ whose name starts with
# a digit (NN-name; number in tens so a new check slots in between). It
# must be executable. A check that has lost its x bit BLOCKS instead of
# being skipped: a gate that silently stops running looks exactly like a
# gate that passes. Anything else in that directory (its index.cld) is
# not a check.
#
# Also BLOCKED, loudly: a staged path holding a newline (it cannot be
# handed on safely), a temp tree that cannot be built, a pre-commit.d
# with no checks in it, a commit that removes pre-commit.d or a check
# HEAD has, and a commit made with the toolkit in the work tree but not
# in the commit (the gate runs the copy in the commit, so there would be
# none). A tree that never had pre-commit.d, in a work tree without one
# either (an older branch, or another repo sharing a core.hooksPath),
# runs no .cld checks, and says so.
#
# There is no sanctioned bypass. git's own --no-verify skips hooks
# entirely and cannot be refused from here, but the rule is fix the
# violations -- so this hook does not advertise it.
#
# POSIX sh only.

set -u

CHECKS_REL=scripts/git-hooks/pre-commit.d
CR=$(printf '\r')
TAB=$(printf '\t')

die() {
  printf 'pre-commit: BLOCKED -- %s\n' "$1" >&2
  exit 2
}

usage() {
  printf 'usage: %s [--audit]\n' "$0" >&2
  exit 2
}

mode=hook
if [ "$#" -gt 0 ]; then
  case $1 in
    --audit) mode=audit ;;
    *) usage ;;
  esac
  shift
  [ "$#" -eq 0 ] || usage
fi

here=$(CDPATH= cd "$(dirname "$0")" && pwd) ||
  die "cannot find the directory this hook runs from"
hook=${0##*/}
self=$here/$hook
chain=$here/cld-chained/$hook

# Find the repo before moving: a relative GIT_DIR means "from here".
top=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ] ||
  die "not inside a git work tree"
gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) && [ -n "$gitdir" ] ||
  die "cannot find the git directory"
cd "$top" || die "cannot cd to $top"
if [ -n "${GIT_DIR:-}" ]; then GIT_DIR=$gitdir; export GIT_DIR; fi
if [ -n "${GIT_WORK_TREE:-}" ]; then GIT_WORK_TREE=$top; export GIT_WORK_TREE; fi
case ${GIT_INDEX_FILE:-} in
  ''|/*) : ;;
  *) GIT_INDEX_FILE=$top/$GIT_INDEX_FILE; export GIT_INDEX_FILE ;;
esac

overall=0     # a check found something
broken=0      # a check could not run
chain_rc=0    # the chained hook's exit status

finish() {
  if [ "$mode" = audit ]; then
    if [ "$broken" -ne 0 ]; then
      echo "pre-commit --audit: the hook would BLOCK this commit -- a check could not run (a broken setup, above), so nothing is known about the indexes"
      exit 2
    elif [ "$overall" -ne 0 ]; then
      echo "pre-commit --audit: the hook would BLOCK this commit"
      exit 1
    fi
    echo "pre-commit --audit: the hook would let this commit through"
    exit 0
  fi
  [ "$broken" -eq 0 ] && [ "$overall" -eq 0 ] && [ "$chain_rc" -eq 0 ] && exit 0
  echo ""
  if [ "$broken" -ne 0 ]; then
    echo "BLOCKED: the gate could not run every check (see above). A check that"
    echo "  cannot run, or that the commit removes, blocks: fix that, then commit."
  fi
  if [ "$overall" -ne 0 ]; then
    echo "BLOCKED: one or more pre-commit checks failed."
    echo "  fix the violations above -- you own every violation in a"
    echo "  file you commit, not only the ones you introduced."
  fi
  if [ "$chain_rc" -ne 0 ]; then
    echo "BLOCKED by the chained hook $chain (exit $chain_rc):"
    echo "  its own output is above; it ran first, before the .cld checks."
  fi
  echo ""
  [ "$broken" -ne 0 ] && exit 2
  exit 1
}

# shell_of <first line> <file> -- if git would run this hook with a
# POSIX-family shell, set SH_INTERP to that shell (as its #! line names
# it) and SH_OPT to its one option word, if any. A file with no #! line
# is exec'd by git, which falls back to sh only when the kernel refuses
# it: so a text file is run with sh, and a compiled hook (an ELF or
# Mach-O binary: control bytes in its first block) is run directly.
# Anything else leaves SH_INTERP empty.
shell_of() {
  SH_INTERP=
  SH_OPT=
  case $1 in
    '#!'*) : ;;
    *)
      so_c=$(dd if="$2" bs=512 count=1 2>/dev/null |
             LC_ALL=C tr -d '\011\012\015\040-\176\200-\377' | wc -c | tr -d ' ')
      [ "${so_c:-1}" = 0 ] && SH_INTERP=/bin/sh
      return 0 ;;
  esac
  so_l=${1#??}
  so_l=${so_l%"$CR"}
  set -f
  # shellcheck disable=SC2086
  set -- $so_l
  set +f
  [ "$#" -ge 1 ] || return 0
  so_i=$1
  shift
  if [ "${so_i##*/}" = env ]; then
    # #!/usr/bin/env [-S] [VAR=x ...] shell: env finds it in PATH
    while [ "$#" -gt 0 ]; do
      case $1 in -*|*=*) shift ;; *) break ;; esac
    done
    [ "$#" -ge 1 ] || return 0
    so_i=$1
    shift
  fi
  case ${so_i##*/} in
    sh|dash|bash|ksh|mksh|pdksh|zsh|ash|posh|yash) : ;;
    *) return 0 ;;
  esac
  case $# in
    0) : ;;
    1) case $1 in -*) SH_OPT=$1 ;; *) return 0 ;; esac ;;
    *) return 0 ;;
  esac
  SH_INTERP=$so_i
}

# --- 1. the chained foreign hook -------------------------------------------
if [ "$mode" = hook ]; then
  if [ -f "$chain" ] && [ -x "$chain" ]; then
    first=
    { IFS= read -r first || :; } < "$chain" 2>/dev/null
    shell_of "$first" "$chain"
    if [ -z "$SH_INTERP" ]; then
      "$chain"
    elif [ -n "$SH_OPT" ]; then
      CLD_CHAINED_HOOK=$chain "$SH_INTERP" "$SH_OPT" -c '. "$CLD_CHAINED_HOOK"' "$self"
    else
      CLD_CHAINED_HOOK=$chain "$SH_INTERP" -c '. "$CLD_CHAINED_HOOK"' "$self"
    fi
    chain_rc=$?
    if [ "$chain_rc" -ne 0 ]; then
      echo "pre-commit: the chained hook $chain failed (exit $chain_rc)"
    fi
  elif [ -e "$chain" ] || [ -L "$chain" ]; then
    echo "pre-commit: note: $chain is not an executable file, so it is" \
         "not run (git would not run it either)"
  fi
fi

work=$(mktemp -d) || die "cannot make a temp directory"
trap 'rm -rf "$work"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# --- 2. the staged diff ----------------------------------------------------
git -c core.quotePath=false diff --cached --no-renames --no-color \
    --name-status -z > "$work/diff" || die "cannot read the staged diff"
# -z keeps every byte of a name, but the lists below are one path per
# line, so a name holding a newline cannot be handed on. Refuse it.
nl=$(tr -cd '\n' < "$work/diff" | wc -c | tr -d ' ')
[ "$nl" -eq 0 ] ||
  die "a staged path holds a newline character; the .cld checks cannot be handed it safely -- rename it"
tr '\000' '\n' < "$work/diff" > "$work/diff.nl" || die "cannot read the staged diff"
# status and path alternate, one per line
CLD_DP_P="$work/present.raw" CLD_DP_G="$work/gone.raw" awk '
  BEGIN { p = ENVIRON["CLD_DP_P"]; g = ENVIRON["CLD_DP_G"]; printf "" > p; printf "" > g }
  NR % 2 == 1 { st = $0; next }
  { if (st == "D") print > g; else print > p }' "$work/diff.nl" ||
  die "cannot read the staged diff"

if [ ! -s "$work/present.raw" ] && [ ! -s "$work/gone.raw" ]; then
  [ "$mode" = audit ] && echo "pre-commit --audit: nothing staged"
  finish
fi

# --- 3. which checks: the commit's own, and none of HEAD's missing ---------
git -c core.quotePath=false ls-files -s -z > "$work/ls.z" ||
  die "cannot list the staged tree"
# A tracked name holding a newline cannot be listed one per line; only a
# full checkout copes with it (and no check is handed it).
lsnl=$(tr -cd '\n' < "$work/ls.z" | wc -c | tr -d ' ')
tr '\000' '\n' < "$work/ls.z" > "$work/ls" || die "cannot list the staged tree"
# the names in pre-commit.d, in the commit and in HEAD
awk -v pre="$CHECKS_REL/" '
  { t = index($0, "\t"); p = substr($0, t + 1) }
  index(p, pre) == 1 { n = substr(p, length(pre) + 1); sub(/\/.*/, "", n); print n }
' "$work/ls" | LC_ALL=C sort -u > "$work/checks.staged" ||
  die "cannot list the staged checks"
if [ ! -s "$work/checks.staged" ]; then
  if git cat-file -e "HEAD:$CHECKS_REL" 2>/dev/null; then
    die "this commit removes $CHECKS_REL, the gate's own checks; a commit cannot switch off its own gate (to retire the toolkit, uninstall the hook first)"
  fi
  if [ -d "$top/$CHECKS_REL" ]; then
    die "the .cld toolkit is in this work tree but not in the commit ($CHECKS_REL is not staged): the gate runs the copy in the commit, so commit scripts/ and cld.conf first -- in this commit, or one of their own"
  fi
  echo "pre-commit: this tree has no $CHECKS_REL, so no .cld checks run"
  finish
fi
if git cat-file -e "HEAD:$CHECKS_REL" 2>/dev/null; then
  git ls-tree --name-only "HEAD:$CHECKS_REL" > "$work/checks.head" ||
    die "cannot list HEAD's checks"
  # A check renamed to another check name (renumbered) still runs. The
  # renames inside pre-commit.d, as git pairs them: the old names whose
  # new name is a check too.
  git -c core.quotePath=false diff --cached -M --no-color --name-status -z \
      HEAD -- "$CHECKS_REL" > "$work/checks.diff" ||
    die "cannot compare the checks with HEAD's"
  tr '\000' '\n' < "$work/checks.diff" | awk -v pre="$CHECKS_REL/" '
    st == "" { st = $0; need = (st ~ /^[RC]/) ? 2 : 1; got = 0; next }
    {
      v[++got] = $0
      if (got < need) next
      if (st ~ /^R/ && index(v[1], pre) == 1 && index(v[2], pre) == 1) {
        a = substr(v[1], length(pre) + 1); b = substr(v[2], length(pre) + 1)
        if (a !~ /\// && b !~ /\// && b ~ /^[0-9]/) print a
      }
      st = ""
    }' > "$work/checks.renamed" || die "cannot compare the checks with HEAD's"
  while IFS= read -r name; do
    case $name in [0-9]*) : ;; *) continue ;; esac
    grep -F -x -q -e "$name" "$work/checks.staged" && continue
    grep -F -x -q -e "$name" "$work/checks.renamed" && continue
    echo "pre-commit: BLOCKED -- this commit removes the check $CHECKS_REL/$name that HEAD runs" \
         "(deleted, or renamed to a name that is not a check); a commit cannot switch off" \
         "its own gate -- keep it, or retire it in a commit made with the hook uninstalled"
    broken=1
  done < "$work/checks.head"
fi

# --- 4. the staged tree ----------------------------------------------------
mkdir "$work/tree" && tree=$(CDPATH= cd "$work/tree" && pwd -P) ||
  die "cannot make the temp tree"
# A sparse checkout marks the files outside it skip-worktree, and
# checkout-index skips those by default -- a tree with holes in it, where
# every entry naming a hole reads as missing. Ask for them where git can.
sw=
if git checkout-index -h 2>&1 | grep -q 'ignore-skip-worktree-bits'; then
  sw=--ignore-skip-worktree-bits
fi

# checkout <list> -- materialise the listed paths, with content, over
# anything already there (a placeholder, or a file checked out before). No
# LFS downloads for a gate (pointer files are enough to know a file is
# there), and no CRLF conversion: the tree holds the bytes being
# committed.
checkout() {
  tr '\n' '\000' < "$1" > "$1.z" || die "cannot write $1.z"
  GIT_LFS_SKIP_SMUDGE=1 git -c core.autocrlf=false \
      checkout-index -f -z --stdin $sw --prefix="$tree/" < "$1.z" ||
    die "cannot materialise the staged tree in $tree"
}

checkout_all() {
  rm -rf "$tree" && mkdir "$tree" || die "cannot make the temp tree"
  GIT_LFS_SKIP_SMUDGE=1 git -c core.autocrlf=false \
      checkout-index -a $sw --prefix="$tree/" ||
    die "cannot materialise the staged tree in $tree"
}

# The partial tree. One awk over the staged listing decides, per entry:
# content (the toolkit, staged paths and every .cld in a touched
# directory, symlinks there), a placeholder (any other file there: its
# existence and type are all a check asks of it), or a directory to make.
# A touched directory is the directory of a staged path, and of a deleted
# path and of each of its vanished ancestors -- exactly where the checks
# look. Returns 1 when only the whole tree will do: a check would follow
# a symlink out of the partial tree (a staged symlink, a symlinked .cld,
# a symbol index whose target is or runs through one), or an index entry
# names a path below its own directory.
partial_tree() {
  CLD_PT_LS="$work/ls" CLD_PT_PRES="$work/present.raw" CLD_PT_GONE="$work/gone.raw" \
  CLD_PT_CONTENT="$work/pt.content" CLD_PT_PH="$work/pt.ph" CLD_PT_DIRS="$work/pt.dirs" \
  CLD_PT_CLD="$work/pt.cld" CLD_PT_FULL="$work/pt.full" \
  awk '
    function dirof(p) { return match(p, /\/[^\/]*$/) ? substr(p, 1, RSTART - 1) : "." }
    function tool(p) {
      return p == "cld.conf" || index(p, "scripts/cld-") == 1 ||
             index(p, "scripts/git-hooks/") == 1 || index(p, "scripts/index-audit/") == 1 ||
             index(p, "scripts/symbol-audit/") == 1 || index(p, "scripts/symbol-lookup/") == 1
    }
    function mkd(d) { if (d != "." && !(d in made)) { made[d] = 1; print d > dirs } }
    BEGIN {
      ls = ENVIRON["CLD_PT_LS"]; content = ENVIRON["CLD_PT_CONTENT"]
      ph = ENVIRON["CLD_PT_PH"]; dirs = ENVIRON["CLD_PT_DIRS"]; cld = ENVIRON["CLD_PT_CLD"]
      printf "" > content; printf "" > ph; printf "" > dirs; printf "" > cld
      full = 0
      n = 0
      while ((getline l < ls) > 0) {
        t = index(l, "\t"); if (!t) continue
        split(substr(l, 1, t - 1), h, " ")
        p = substr(l, t + 1); mode[p] = h[1]; order[++n] = p
        a = p
        while ((a = dirof(a)) != "." && !(a in isdir)) isdir[a] = 1
      }
      close(ls)
      # staged paths: their directories are touched; a staged symbol
      # index names a target to fetch; a staged symlink may be followed
      f = ENVIRON["CLD_PT_PRES"]
      while ((getline p < f) > 0) {
        pres[p] = 1; touched[dirof(p)] = 1
        if ((p in mode) && mode[p] == "120000") full = 1
        if (p ~ /\.cld$/ && p !~ /(^|\/)index\.cld$/) print p > cld
      }
      close(f)
      # deleted paths and their vanished ancestors: the directory of each
      # is touched, and a <path>.cld left beside one names a target too
      f = ENVIRON["CLD_PT_GONE"]
      while ((getline g < f) > 0) {
        x = g
        while (x != "." && !(x in mode) && !(x in isdir)) {
          touched[dirof(x)] = 1; print x ".cld" > cld; x = dirof(x)
        }
      }
      close(f)
      for (i = 1; i <= n; i++) {
        p = order[i]; d = dirof(p); m = mode[p]
        if (tool(p)) print p > content
        else if (d in touched) {
          if (m == "120000" && p ~ /\.cld$/) full = 1
          if ((p in pres) || p ~ /\.cld$/ || m == "120000" || m == "160000") print p > content
          else { mkd(d); print p > ph }
        }
        # the subdirectories of a touched directory exist, as directories
        a = p
        while ((a = dirof(a)) != ".") if (dirof(a) in touched) mkd(a)
      }
      if (full) print "FULL" > ENVIRON["CLD_PT_FULL"]
    }' < /dev/null || die "cannot work out which part of the staged tree to build"
  [ ! -f "$work/pt.full" ] || return 1
  # directories, many per mkdir
  if [ -s "$work/pt.dirs" ]; then
    set --
    while IFS= read -r d; do
      set -- "$@" "$tree/$d"
      if [ "$#" -ge 200 ]; then mkdir -p "$@" || die "cannot make the temp tree"; set --; fi
    done < "$work/pt.dirs"
    [ "$#" -eq 0 ] || mkdir -p "$@" || die "cannot make the temp tree"
  fi
  if [ -s "$work/pt.ph" ]; then
    while IFS= read -r p; do
      : > "$tree/$p" || die "cannot make the temp tree"
    done < "$work/pt.ph"
  fi
  [ ! -s "$work/pt.content" ] || checkout "$work/pt.content"
  # An entry whose name reaches below its own directory (F sub/x.js) asks
  # about a path the partial tree may not hold: build it all instead.
  grep -e '/index\.cld$' -e '^index\.cld$' "$work/pt.content" > "$work/pt.idx"
  [ "$?" -le 1 ] || die "cannot list the touched indexes"
  if [ -s "$work/pt.idx" ]; then
    CLD_PT_TREE=$tree awk '
      BEGIN { tr = ENVIRON["CLD_PT_TREE"] }
      {
        f = tr "/" $0
        while ((getline l < f) > 0) {
          sub(/\r$/, "", l)
          if (l !~ /^[FDLPSBC] /) continue
          c = substr(l, 3); k = index(c, "  "); if (k) c = substr(c, 1, k - 1)
          sub(/\/$/, "", c)
          if (index(c, "/")) { print "FULL"; exit }
        }
        close(f)
      }' "$work/pt.idx" < /dev/null > "$work/pt.deep" || return 1
    [ ! -s "$work/pt.deep" ] || return 1
  fi
  # The targets the symbol indexes name: a staged one's, and the one a
  # deleted path's left-behind <path>.cld names. Their content is read
  # (SYM-STALE, the #! line), so they are checked out with it.
  : > "$work/pt.targets"
  while IFS= read -r p; do
    [ -f "$tree/$p" ] || continue
    h1=
    { IFS= read -r h1 || :; } < "$tree/$p"
    h1=${h1%"$CR"}
    case $h1 in "FILE "*) printf '%s\n' "${h1#FILE }" >> "$work/pt.targets" ;; esac
  done < "$work/pt.cld"
  [ -s "$work/pt.targets" ] || return 0
  # Spelled the way the checker spells them (cld_norm). A target that is
  # a symlink, or is reached through one, points who knows where.
  CLD_PT_LS="$work/ls" awk '
    function norm(p,   n, a, i, k, o, out) {
      n = split(p, a, "/"); k = 0
      for (i = 1; i <= n; i++) {
        if (a[i] == "" || a[i] == ".") continue
        if (a[i] == "..") { if (k > 0 && o[k] != "..") k--; else o[++k] = ".."; continue }
        o[++k] = a[i]
      }
      out = ""
      for (i = 1; i <= k; i++) out = (i == 1) ? o[i] : out "/" o[i]
      return out
    }
    BEGIN {
      ls = ENVIRON["CLD_PT_LS"]
      while ((getline l < ls) > 0) {
        t = index(l, "\t"); split(substr(l, 1, t - 1), h, " "); mode[substr(l, t + 1)] = h[1]
      }
      close(ls)
    }
    { t = norm($0) }
    t in seen { next }
    { seen[t] = 1 }
    t in mode {
      if (mode[t] == "120000") { print "FULL"; exit }
      print t
      next
    }
    {
      a = t
      while (match(a, /\/[^\/]*$/)) {
        a = substr(a, 1, RSTART - 1)
        if ((a in mode) && mode[a] == "120000") { print "FULL"; exit }
      }
    }' "$work/pt.targets" > "$work/pt.t2" || die "cannot work out the symbol index targets"
  grep -q -x FULL "$work/pt.t2" && return 1
  [ ! -s "$work/pt.t2" ] || checkout "$work/pt.t2"
  return 0
}

# Every check must say it reads only what the partial tree holds;
# otherwise -- or when a tracked name holds a newline -- build it all.
whole=0
[ "$lsnl" -eq 0 ] || whole=1
if [ "$whole" -eq 0 ]; then
  : > "$work/pt.checks"
  while IFS= read -r name; do
    case $name in [0-9]*) printf '%s/%s\n' "$CHECKS_REL" "$name" >> "$work/pt.checks" ;; esac
  done < "$work/checks.staged"
  [ -s "$work/pt.checks" ] && checkout "$work/pt.checks"
  while IFS= read -r c; do
    if [ -L "$tree/$c" ] || [ ! -f "$tree/$c" ] ||
       ! grep -q '^# cld-gate: partial-tree$' "$tree/$c"; then
      whole=1
      break
    fi
  done < "$work/pt.checks"
fi
if [ "$whole" -eq 0 ]; then
  partial_tree || whole=1
fi
[ "$whole" -eq 0 ] || checkout_all

checks_dir=$tree/$CHECKS_REL
checks=
nchecks=0
for c in "$checks_dir"/*; do
  name=${c##*/}
  case $name in
    [0-9]*) : ;;
    *) continue ;;
  esac
  [ -e "$c" ] || [ -L "$c" ] || continue
  nchecks=$((nchecks + 1))
  if [ ! -f "$c" ]; then
    echo "pre-commit: BLOCKED -- $CHECKS_REL/$name is not a file, so it cannot run"
    broken=1
  elif [ ! -x "$c" ]; then
    echo "pre-commit: BLOCKED -- $CHECKS_REL/$name is not executable, so it cannot run;" \
         "a check that cannot run blocks, it is never skipped" \
         "(chmod +x it, then git add it)"
    broken=1
  else
    checks="$checks$c
"
  fi
done
[ "$nchecks" -gt 0 ] ||
  die "$CHECKS_REL holds no checks (files named NN-name); a gate with nothing in it is not a gate"

# The hook git runs is a copy. One that differs from the dispatcher in
# the commit is out of date (or the commit changes the dispatcher): say
# so. --audit runs the work-tree copy, so it looks at the installed one,
# and also says when there is none, or a foreign one -- a verdict here
# is worth nothing if no real commit is judged by it.
is_ours() {
  grep -q 'marker: cld-dispatcher' "$1" 2>/dev/null && return 0
  grep -q '^# @brief Pre-commit dispatcher: run every executable in$' "$1" 2>/dev/null &&
    grep -qF 'dispatch_dir="$repo/scripts/git-hooks/pre-commit.d"' "$1" 2>/dev/null
}
installed=$self
if [ "$mode" = audit ]; then
  installed=$(git rev-parse --git-path hooks/pre-commit 2>/dev/null) || installed=
  case $installed in ''|/*) : ;; *) installed=$top/$installed ;; esac
  if [ -n "$installed" ] && [ ! -f "$installed" ]; then
    echo "pre-commit: note: no hook is installed at $installed, so no real commit" \
         "is judged like this -- run scripts/git-hooks/install.sh"
  elif [ -n "$installed" ] && ! is_ours "$installed"; then
    echo "pre-commit: note: the installed hook $installed is not the .cld dispatcher," \
         "so a real commit may not be judged like this -- run scripts/git-hooks/install.sh" \
         "(it chains a foreign hook), or call the dispatcher from your hook manager"
    installed=
  fi
fi
if [ -n "$installed" ] && [ -f "$installed" ] && [ -f "$tree/scripts/git-hooks/pre-commit" ] &&
   ! cmp -s "$installed" "$tree/scripts/git-hooks/pre-commit"; then
  echo "pre-commit: note: the installed hook $installed is not the dispatcher in this" \
       "commit (scripts/git-hooks/pre-commit); unless this commit changes it, re-run" \
       "scripts/git-hooks/install.sh"
fi

# --- 5. routing ------------------------------------------------------------
exists() { [ -e "$tree/$1" ] || [ -L "$tree/$1" ]; }

LC_ALL=C sort -u "$work/present.raw" > "$work/present.sorted" ||
  die "cannot sort the staged paths"
# (each loop writes through one redirection, not one open per path)
while IFS= read -r p; do
  if exists "$p"; then printf '%s\n' "$p"; else printf '%s\n' "$p" >&4; fi
done < "$work/present.sorted" > "$work/present" 4> "$work/present.unmat" ||
  die "cannot route the staged paths"
while IFS= read -r p; do
  echo "pre-commit: note: $p is staged but was not materialised, so it is not checked"
done < "$work/present.unmat"

while IFS= read -r p; do
  exists "$p" && continue
  printf '%s\n' "$p"
  d=$p
  while :; do
    case $d in
      */*) d=${d%/*} ;;
      *) break ;;
    esac
    exists "$d" && break
    printf '%s\n' "$d"
  done
done < "$work/gone.raw" > "$work/gone.all" || die "cannot route the deleted paths"
LC_ALL=C sort -u "$work/gone.all" > "$work/gone" || die "cannot sort the deleted paths"

if [ "$mode" = audit ]; then
  show() {
    n=$(wc -l < "$2" | tr -d ' ')
    echo "  $1 ($n)"
    sed -n '1,200s/^/    /p' "$2"
    [ "$n" -le 200 ] || echo "    ... and $((n - 200)) more"
  }
  echo "pre-commit --audit: the staged diff, routed as the hook routes it"
  show "present -- checked as they will be committed" "$work/present"
  show "gone -- deleted or renamed away, passed after --gone" "$work/gone"
  echo ""
fi

# The whole list in one file, for a check that reads it from there
# (cld-gate: paths-from), a root-level name starting with '-' as ./-name.
{
  sed 's#^-#./-#' "$work/present"
  if [ -s "$work/gone" ]; then
    echo --gone
    sed 's#^-#./-#' "$work/gone"
  fi
} > "$work/args" || die "cannot write the argument list"
[ -s "$work/args" ] || finish

# Batches, for a check that takes its paths as arguments: one argument
# list per call, kept well inside ARG_MAX (a name's length is counted in
# characters, which can undercount bytes -- hence the wide margin). Made
# when the first such check needs them.
argmax=$(getconf ARG_MAX 2>/dev/null) || argmax=
case $argmax in
  ''|*[!0-9]*) argmax=262144 ;;
esac
budget=$((argmax / 8))
[ "$budget" -ge 2048 ] || budget=2048
nb=0
batches=
make_batches() {
  CLD_MB_DIR=$work CLD_MB_BUDGET=$budget awk '
    BEGIN { dir = ENVIRON["CLD_MB_DIR"]; budget = ENVIRON["CLD_MB_BUDGET"] + 0
            list = dir "/batches"; printf "" > list; cur = "" }
    function newb() {
      if (cur != "") close(cur)
      nb++; cur = dir "/batch." (100000 + nb); printf "" > cur; print cur > list
      bytes = 0; gopen = 0
    }
    {
      a = $0; if (a ~ /^-/) a = "./" a
      sz = length(a) + 16
      if (cur == "" || (bytes > 0 && bytes + sz > budget)) newb()
      if (FILENAME != ARGV[1] && !gopen) { print "--gone" > cur; gopen = 1; bytes += 16 }
      print a > cur; bytes += sz
    }' "$work/present" "$work/gone" || die "cannot split the argument list"
  batches=$(cat "$work/batches") || die "cannot split the argument list"
  nb=$(wc -l < "$work/batches" | tr -d ' ')
}

# --- 6. run the checks inside the staged tree ------------------------------
GIT_DIR=$gitdir
GIT_WORK_TREE=$tree
CLD_GATE_CONTRACT=2
export GIT_DIR GIT_WORK_TREE CLD_GATE_CONTRACT
cd "$tree" || die "cannot cd to the temp tree"

set -f
IFS='
'
for check in $checks; do
  rc=0
  if grep -q '^# cld-gate: paths-from$' "$check"; then
    "$check" --paths-from "$work/args"
    rc=$?
  else
    [ -n "$batches" ] || make_batches
    if [ "$nb" -le 1 ]; then
      for b in $batches; do
        set -- $(cat "$b")
        "$check" "$@"
        rc=$?
      done
    else
      # More than one call: each line the check printed is shown once,
      # however many calls repeated it, and the worst exit status counts.
      : > "$work/out"
      for b in $batches; do
        set -- $(cat "$b")
        "$check" "$@" >> "$work/out" 2>&1
        brc=$?
        case $brc in
          0) : ;;
          1) [ "$rc" -ne 0 ] || rc=1 ;;
          *) rc=$brc ;;
        esac
      done
      awk '!seen[$0]++' "$work/out"
      echo "pre-commit: ${check##*/} ran in $nb calls (too many paths for one); each line it printed is shown once"
    fi
  fi
  case $rc in
    0) : ;;
    1) overall=1 ;;
    *) echo "pre-commit: ${check##*/} could not check (exit $rc) -- a check that cannot run blocks"
       broken=1 ;;
  esac
done
unset IFS
set +f

finish
